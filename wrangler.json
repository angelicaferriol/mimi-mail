{
  "name": "mimi-mail",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".vercel/output/static",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mimi-mail-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
